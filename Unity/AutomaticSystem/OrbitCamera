using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.InputSystem;

public static class EditManager
{
    
}

public class OrbitCamera
{
    public OrbitCamera(Camera cra)
    {
        m_Camera = cra;

        pivot = cra.transform.position + cra.transform.forward * distance;

        distance = Vector3.Distance(cra.transform.position, pivot);

        Vector3 dir = (cra.transform.position - pivot).normalized;

        angle.y = Mathf.Asin(dir.y) * Mathf.Rad2Deg;
        angle.x = Mathf.Atan2(dir.x, dir.z) * Mathf.Rad2Deg;
    }

    public void SetPivotPos(Vector3 v3, Vector3 direction, float Distance = 5f, float pitchAngle = 30f)
    {
        pivot = v3;

        direction = direction.normalized;
        pitchAngle = Mathf.Clamp(pitchAngle, 0, 45f);

        Vector3 right = Vector3.Cross(Vector3.up, direction).normalized;

        if (right.sqrMagnitude < 0.001f)
            right = Vector3.right;

        Quaternion pitchRot = Quaternion.AngleAxis(pitchAngle, right);
        direction = pitchRot * direction;

        distance = Distance;

        m_Camera.transform.position = pivot + direction * distance;

        m_Camera.transform.LookAt(pivot);

        Vector3 dir = (m_Camera.transform.position - pivot).normalized;
        angle.y = Mathf.Asin(dir.y) * Mathf.Rad2Deg;
        angle.x = Mathf.Atan2(dir.x, dir.z) * Mathf.Rad2Deg;
    }

    public void SetPivotPos(Vector3 v3, float Distance = 5f, float pitchAngle = 30f)
    {
        pivot = v3;

        Vector3 direction = m_Camera.transform.forward.normalized;
        pitchAngle = Mathf.Clamp(pitchAngle, 0, 45f);

        Vector3 right = Vector3.Cross(Vector3.up, direction).normalized;

        if (right.sqrMagnitude < 0.001f)
            right = Vector3.right;

        Quaternion pitchRot = Quaternion.AngleAxis(pitchAngle, right);
        direction = pitchRot * direction;

        distance = Distance;

        m_Camera.transform.position = pivot + direction * distance;

        m_Camera.transform.LookAt(pivot);

        Vector3 dir = (m_Camera.transform.position - pivot).normalized;
        angle.y = Mathf.Asin(dir.y) * Mathf.Rad2Deg;
        angle.x = Mathf.Atan2(dir.x, dir.z) * Mathf.Rad2Deg;
    }

    Camera m_Camera;

    Vector3 pivot;
    Vector2 angle;
    float distance = 10f;

    public void OnUpdate()
    {
        if (isSmoothMoving)
        {
            animationTime += Time.deltaTime;

            float t = animationTime / animationDuration;

            t = Mathf.Clamp01(t);
            // t = t * t * (3f - 2f * t);

            pivot = Vector3.Lerp(startPivot, targetPivot, t);

            distance = Mathf.Lerp(startDistance, targetDistance, t);

            if (t >= 1f)
                isSmoothMoving = false;
        }

        float scroll = Mouse.current.scroll.ReadValue().y;

        float deltaScrol = scroll * Time.deltaTime * 0.5f;

        float newDistance = distance - deltaScrol;

        if (newDistance < 0.1f)
        {
            float overflow = 0.1f - newDistance;
            pivot += m_Camera.transform.forward * overflow;

            distance = 0.1f;
        }
        else
        {
            distance = newDistance;
        }

        if (Mouse.current.rightButton.isPressed)
        {
            isSmoothMoving = false;

            Vector3 delta = Mouse.current.delta.ReadValue();
            angle.x += delta.x * Time.deltaTime * (7.5f + Mathf.Sqrt(distance) * 2f);
            angle.y += delta.y * Time.deltaTime * (7.5f + Mathf.Sqrt(distance) * 2f);

            angle.x = Mathf.Repeat(angle.x, 360f);
            angle.y = Mathf.Clamp(angle.y, -80, 80);
        }
        else if (Mouse.current.middleButton.isPressed)
        {
            isSmoothMoving = false;

            Vector2 delta = Mouse.current.delta.ReadValue();

            float moveSpeed = Time.deltaTime * (1 + distance) * 0.75f;

            pivot -= m_Camera.transform.right * delta.x * moveSpeed;
            pivot -= m_Camera.transform.up * delta.y * moveSpeed;
        }

        UpdateCameraTransform();
    }

    void UpdateCameraTransform()
    {
        Quaternion rot = Quaternion.AngleAxis(angle.x, Vector3.up) *
                             Quaternion.AngleAxis(angle.y, Vector3.right);

        Vector3 offset = rot * new Vector3(0, 0, distance);
        Vector3 cameraPos = pivot + offset;

        m_Camera.transform.position = cameraPos;
        m_Camera.transform.LookAt(pivot);
    }

    bool isSmoothMoving = false;

    Vector3 startPivot;
    Vector3 targetPivot;

    float startDistance;
    float targetDistance;

    float animationTime;
    float animationDuration;

    public void SmoothSetPivot(Vector3 newPivot, float newDistance = 2f, float duration = 0.35f)
    {
        startPivot = pivot;
        targetPivot = newPivot;

        startDistance = distance;
        targetDistance = newDistance;

        animationTime = 0f;
        animationDuration = Mathf.Max(0.01f, duration);

        isSmoothMoving = true;
    }
}
